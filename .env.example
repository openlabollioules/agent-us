# Agent Us — configuration LLM
# Provider actif : mock | vllm | claude | openai
LLM_PROVIDER=mock

# vLLM (API compatible OpenAI) — utilisé si LLM_PROVIDER=vllm
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
LLM_API_KEY=EMPTY

# Public
NEXT_PUBLIC_APP_NAME=Agent Us
NEXT_PUBLIC_DEBUG=true
