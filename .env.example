# Agent Us — configuration LLM / runtime agentique
#
# Backend de VERBALISATION : "hermes" (cible) | "vllm" | "openrouter".
# Vide = mode déterministe (aucun backend) : les messages d'agents restent
# tels quels. Le cœur du jeu (simulation, skills, MCP, scoring) tourne toujours
# sans LLM ; le backend ne sert qu'à reformuler les messages d'agents.
LLM_PROVIDER=

# Active la verbalisation côté client (sinon aucun appel réseau). Mettre à 1
# en même temps que LLM_PROVIDER pour brancher réellement le backend.
NEXT_PUBLIC_LLM_ENABLED=0

# Hermes Agent — serveur agentique (mode gateway), API server compatible OpenAI.
# Port 8642 (voir hermes/README.md). Clé : docker exec hermes env | grep API_SERVER_KEY
HERMES_BASE_URL=http://localhost:8642/v1
HERMES_MODEL=hermes-agent
HERMES_API_KEY=EMPTY

# vLLM brut (sans couche agentique)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-30B-A3B

# OpenRouter (distant)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-30b-a3b

# Clé pour vLLM/OpenRouter directs : "EMPTY" pour vLLM local, clé OpenRouter sinon
LLM_API_KEY=EMPTY

NEXT_PUBLIC_APP_NAME=Agent Us
NEXT_PUBLIC_DEBUG=true
